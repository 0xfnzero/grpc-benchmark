# =============================================================================
# Multiple gRPC endpoints for comparison (pattern: GRPC_URL_*, GRPC_NAME_*, GRPC_TOKEN_*)
# =============================================================================

# Endpoint 1 - Custom Node
GRPC_URL_1=http://64.130.32.158:10900
GRPC_NAME_1=Custom_Node
GRPC_TOKEN_1=

# Endpoint 2 - PublicNode Default
GRPC_URL_2=https://solana-yellowstone-grpc.publicnode.com:443
GRPC_NAME_2=PublicNode_Default
GRPC_TOKEN_2=

# Add more endpoints as needed (increment the number)
# GRPC_URL_3=https://another-endpoint.com:443
# GRPC_NAME_3=Another_Node
# GRPC_TOKEN_3=your-token-here

# Test duration for endpoint comparison in seconds
GRPC_COMPARISON_DURATION_SEC=30

# Concurrency level for parallel tests (0 for serial mode)
CONCURRENCY=10

# =============================================================================
# Latency Test Configuration (latency-test binary)
# =============================================================================

# Default gRPC endpoint (used by latency-test and other tools)
GRPC_URL=https://solana-yellowstone-grpc.publicnode.com:443
GRPC_TOKEN=

# Number of ping requests to send
TOTAL_ROUNDS=10

# Interval between pings in milliseconds (serial mode only)
PING_INTERVAL_MS=1000

# Test timeout in seconds
TEST_TIMEOUT=120

# =============================================================================
# Jito Configuration
# =============================================================================

# Jito Block Engine endpoint
JITO_URL=https://amsterdam.mainnet.block-engine.jito.wtf
JITO_CONCURRENCY=10

# =============================================================================
# Shred comparison: modes slot | shred | transaction; sources udp | entries-grpc
# See docs/shred-comparison.md (Chinese: docs/shred-comparison_CN.md).
# CLI flags override these values. slot preserves the original default.
# =============================================================================
SHRED_COMPARISON_MODE=slot
SHRED_SOURCE_1=udp
SHRED_SOURCE_2=udp
SHRED_BIND_1=0.0.0.0:20000
SHRED_BIND_2=0.0.0.0:20001
SHRED_NAME_1=Provider_A
SHRED_NAME_2=Provider_B
SHRED_COMPARISON_DURATION_SEC=30
SHRED_WARMUP_MS=1000
SHRED_SETTLE_WINDOW_MS=1000
# Required only for entries-grpc inputs:
# SHRED_URL_1=https://provider-a.example:443
# SHRED_URL_2=https://provider-b.example:443
# SHRED_TOKEN_1=
# SHRED_TOKEN_2=
# SHRED_TOKEN_HEADER_1=x-token
# SHRED_TOKEN_HEADER_2=x-token
# SHRED_ENTRIES_METHOD_1=/shredstream.ShredstreamProxy/SubscribeEntries
# SHRED_ENTRIES_METHOD_2=/shredstream.ShredstreamProxy/SubscribeEntries
# SHRED_JSON_OUTPUT=comparison.json

# Shred comparison: prefer copying configs/shred-*.env.example to shred-comparison.env.
# Environment / .env values override that dedicated file. Optional alternate file:
# SHRED_COMPARISON_CONFIG=shred-comparison.env

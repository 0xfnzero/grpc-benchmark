# Copy this template to ../shred-comparison.env (repository/bundle root).
# 修改后运行 / Edit then run: ./run-shred-comparison.sh
# Priority: CLI > environment (including .env) > this file > built-in defaults.
# UDP: configure each provider to send raw Solana shreds to a separate local port.
# Entry gRPC: confirm provider protocol compatibility; see docs/shred-comparison.md.
SHRED_COMPARISON_MODE=shred
SHRED_COMPARISON_DURATION_SEC=60
SHRED_WARMUP_MS=1000
SHRED_SETTLE_WINDOW_MS=1000
SHRED_JSON_OUTPUT=shred-comparison-report.json

SHRED_NAME_1=Provider_A
SHRED_SOURCE_1=udp
SHRED_BIND_1=0.0.0.0:20000
SHRED_DECODE_MODE_1=ledger
SHRED_UDP_PAYLOAD_PREFIX_SKIP_1=0

SHRED_NAME_2=Provider_B
SHRED_SOURCE_2=udp
SHRED_BIND_2=0.0.0.0:20001
SHRED_DECODE_MODE_2=ledger
SHRED_UDP_PAYLOAD_PREFIX_SKIP_2=0

# Optional decoder/capacity controls (normally keep defaults):
# SHRED_RECV_BUFFER_BYTES=134217728
# SHRED_MAX_TRACKED_SLOTS=128
# SHRED_REASSEMBLY_GAP_TIMEOUT_MS=500
# SHRED_RETENTION_SLOTS=128
# SHRED_MAX_KEYS=1000000
# SHRED_MAX_SAMPLES=5000000
